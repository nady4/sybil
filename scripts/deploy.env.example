# AgentsRE deployment secrets — copy to deploy.env at the repo root, fill in, NEVER commit.
# Generate KEYS_ENC_KEY with: openssl rand -hex 32
# Use real Cloudflare secrets / Clerk / Stripe keys; the values here are placeholders.

# Scheduler
KEYS_ENC_KEY=
ADMIN_TOKEN=
OPERATOR_CHANNEL=            # optional: {"type":"slack_webhook","config":{"url":"https://hooks.slack.com/..."}}
OPERATOR_ORG=                # optional: org id for platform alerts

# API
BOOTSTRAP_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=              # https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
CORS_ORIGIN=                 # https://<web-host>

# Alerts (optional)
RESEND_API_KEY=
