{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentsre-docs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
