{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentsre-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsre",
      "migrations_dir": "../scheduler/migrations"
      }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "agentsre-alerts",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 4,
        "dead_letter_queue": "agentsre-alerts-dlq"
      },
      {
        "queue": "agentsre-alerts-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  }
}
